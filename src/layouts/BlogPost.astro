---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				/* Ancho óptimo de lectura para artículos (evita que las líneas sean muy largas) */
				width: 800px; 
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			
			.hero-image {
				width: 100%;
			}
			
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--border-radius);
				/* Le damos la misma sombra mágica que al inicio */
				box-shadow: 0 15px 40px rgba(74, 65, 56, 0.15); 
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
			}
			
			.prose {
				width: 100%;
				max-width: 720px;
				margin: auto;
				padding: 2em 0;
				color: var(--black);
			}
			
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: center; /* Títulos centrados y elegantes */
				line-height: 1;
			}
			
			.title h1 {
				margin: 0 0 0.5em 0;
				color: var(--accent-dark);
				font-weight: bold;
				font-size: 2.8rem;
				line-height: 1.2;
			}
			
			.date {
				margin-bottom: 0.5em;
				color: var(--gray);
				font-size: 1rem;
			}
			
			.last-updated-on {
				font-style: italic;
				font-size: 0.9em;
			}

			/* Separador sutil debajo del título */
			hr {
				border: none;
				border-top: 1px solid var(--gray-light);
				margin: 2em auto;
				width: 50%;
			}
		</style>
	</head>

	<body>
		<!-- Mantenemos el Header aquí para que el lector pueda navegar -->
		<Header />
		
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Ultima actualización: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<!-- Aquí es donde Astro inyecta mágicamente el contenido de tus archivos .md -->
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>