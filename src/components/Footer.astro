---
const today = new Date();
---

<footer>
	<div class="legal-links">
		<a href="/privacidad">Política de Privacidad</a> | 
		<a href="/cookies">Política de Cookies</a> | 
		<a href="/contacto">Contacto</a>
	</div>
	<p>&copy; {today.getFullYear()} Hacerse Bien | Matías. Todos los derechos reservados.</p>
</footer>

<style>
	footer {
		padding: 3em 1em;
		margin-top: 4em;
		color: var(--gray);
		text-align: center;
		border-top: 1px solid var(--gray-light);
	}
	
	.legal-links {
		margin-bottom: 1.5em;
		font-size: 0.9em;
	}
	
	.legal-links a {
		color: var(--gray);
		text-decoration: none;
		margin: 0 0.8em;
		transition: color 0.2s ease;
	}
	
	.legal-links a:hover {
		color: var(--accent-dark);
	}
	
	p {
		margin: 0;
		font-size: 0.85em;
	}
</style>